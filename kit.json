{
  "name": "delegation-audit",
  "version": "0.2.2",
  "requirements": {
    "runtimes": {
      "node": ">=22.6.0"
    }
  },
  "commands": {
    "test": "node --test tests/*.test.mjs",
    "verify-examples": "node skills/delegation-audit/verify-html.mjs examples/01-harbor-electric/audit.html examples/02-mercer-agency/audit.html examples/03-no-rate-given/audit.html",
    "verify-example-data": "node skills/delegation-audit/verify-own-data.mjs examples/01-harbor-electric/tasks.md examples/02-mercer-agency/tasks.md examples/03-no-rate-given/tasks.md",
    "verify-own-data": "node skills/delegation-audit/verify-own-data.mjs --install <audit-folder>/tasks.md"
  }
}
